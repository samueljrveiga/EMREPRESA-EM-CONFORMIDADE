# Gere este arquivo automaticamente com:  npm run setup
NODE_ENV=development
PORT=3001
# Endereço público do site. Em produção, obrigatoriamente https://
APP_URL=http://localhost:3001
# Assina os tokens JWT. Trocar invalida as sessões abertas.
JWT_SECRET=
# Criptografa os dados no banco. PERDER ESTA CHAVE = PERDER OS DADOS. Guarde uma cópia em local seguro.
DATA_ENCRYPTION_KEY=
DB_PATH=./data/plataforma.sqlite
# Quantos proxies existem na frente do app (1 em Render/Railway/Fly)
TRUST_PROXY=0
# Primeiro administrador: criado na primeira inicialização se ainda não houver nenhum.
# A senha é provisória: a troca e o cadastro do 2FA são obrigatórios no primeiro acesso.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
